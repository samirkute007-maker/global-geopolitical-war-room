# Global Geopolitical War Room - Configuration
# Mode setting: 'mock' (default, offline, no OpenAI key required) or 'live' (requires OpenAI API key)
WAR_ROOM_MODE=mock

# OpenAI API Key (Only required when WAR_ROOM_MODE=live for real-time web search and LLM synthesis)
OPENAI_API_KEY=your_openai_api_key_here

# Optional Model override for Live Mode (Default: gpt-4o)
OPENAI_MODEL=gpt-4o
