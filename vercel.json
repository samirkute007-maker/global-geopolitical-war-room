{
  "version": 2,
  "name": "global-geopolitical-war-room",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "include": [
    "frontend/**/*"
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/api/index.py"
    }
  ],
  "env": {
    "WAR_ROOM_MODE": "mock"
  }
}
